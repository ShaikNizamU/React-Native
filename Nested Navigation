import {createBottomTabNavigator} from '@react-navigation/bottom-tabs';
import React, {createRef} from 'react';
import {StyleSheet, Text, View} from 'react-native';
import AttendanceMain from '../screens/AttendanceMain';
import Dashboard from '../screens/Dashboard/dashboard1';
import Diary from '../screens/Diary';
import EStore from '../screens/EStore/EStore';
import EStorePaymentScreen from '../screens/EStore/EStorePaymentScreen';
import NoticeBoard from '../screens/NoticeBoard';
import Notifications from '../screens/Notifications';
import PaymentsMain from '../screens/PaymentsMain';
import PerformanceMain from '../screens/PerformanceMain';
import ProfileScreen from '../screens/ProfileScreen';
import TimeTableMain from '../screens/TimeTableMain';
import Transportation from '../screens/transportation';
import Feedback from '../screens/Feedback';
import {routes, screens} from './RouteItems';
import {COLORS} from '../common/colors';
import Animated, {FadeIn} from 'react-native-reanimated';

const Tab = createBottomTabNavigator();
const tabOptions = ({route}) => {
  const item = routes.find(routeItem => routeItem.name === route.name);
  if (!item.showInTab) {
    // hide this tab
    return {
      tabBarHideOnKeyboard: true,
      tabBarButton: () => <View style={{width: 0}} />,
      headerShown: false,

      tabBarStyle: styles.tabContainer,
      title: item.title,
    };
  }

  return {
    tabBarHideOnKeyboard: true,
    tabBarIcon: ({focused}) => item.icon(focused),
    tabBarLabel: () => (
      <Text style={styles.tabBarLabel}>{item.title || ''}</Text>
    ),

    headerShown: false,
    title: item.title,
    tabBarStyle: styles.tabContainer,
  };
};

const BottomTabNavigator = ({route}) => {
  const {parentNavigator} = route.params;
  return (
    <Tab.Navigator screenOptions={tabOptions}>
      <Tab.Screen name={screens.Dashboard} component={Dashboard} />
      <Tab.Screen name={screens.Noticeboard} component={NoticeBoard} />
      <Tab.Screen name={screens.Notifications} component={Notifications} />
      <Tab.Screen name={screens.PerformanceMain} component={PerformanceMain} />
      <Tab.Screen name={screens.TimeTableMain} component={TimeTableMain} />
      <Tab.Screen name={screens.AttendanceMain} component={AttendanceMain} />
      <Tab.Screen
        options={{
          unmountOnBlur: true,
        }}
        name={screens.PaymentsMain}
        component={PaymentsMain}
      />
      <Tab.Screen name={screens.Diary} component={Diary} />
      <Tab.Screen
        options={{
          unmountOnBlur: true,
        }}
        name={screens.Feedback}
        component={Feedback}
      />
      <Tab.Screen
        // options={{
        //   unmountOnBlur: true,
        // }}
        name={screens.EStore}
        component={EStore}
      />
      <Tab.Screen
        initialParams={{parentNavigator}}
        name={screens.ProfileScreen}
        component={ProfileScreen}
      />
      <Tab.Screen
        options={{
          unmountOnBlur: true,
        }}
        name={screens.EStorePaymentScreen}
        component={EStorePaymentScreen}
      />
      <Tab.Screen
        name={screens.TransportationScreen}
        component={Transportation}
        options={{
          unmountOnBlur: true,
        }}
      />
    </Tab.Navigator>
  );
};

